+def wasserstein_similarity(box1: torch.Tensor, box2: torch.Tensor, c: float, eps: float = 1e-7) -> torch.Tensor:
+    """Normalized Gaussian Wasserstein Distance (NWD) between paired xyxy boxes (EdgeTS-YOLO addition).
+
+    Each box is modelled as N((cx, cy), diag(w^2/4, h^2/4)); then
+    W2^2 = ||[cx1, cy1, w1/2, h1/2] - [cx2, cy2, w2/2, h2/2]||^2 and NWD = exp(-sqrt(W2^2) / c).
+
+    Args:
+        box1, box2 (torch.Tensor): (n, 4) boxes in xyxy pixel coordinates.
+        c (float): normalising constant in pixels (dataset-dependent).
+
+    Returns:
+        (torch.Tensor): (n, 1) similarity in (0, 1].
+    """
+    box1, box2 = box1.float(), box2.float()
+    cx1, cy1 = (box1[:, 0] + box1[:, 2]) / 2, (box1[:, 1] + box1[:, 3]) / 2
+    cx2, cy2 = (box2[:, 0] + box2[:, 2]) / 2, (box2[:, 1] + box2[:, 3]) / 2
+    w1, h1 = box1[:, 2] - box1[:, 0], box1[:, 3] - box1[:, 1]
+    w2, h2 = box2[:, 2] - box2[:, 0], box2[:, 3] - box2[:, 1]
+    w2_sq = (cx1 - cx2) ** 2 + (cy1 - cy2) ** 2 + ((w1 - w2) ** 2 + (h1 - h2) ** 2) / 4
+    return torch.exp(-torch.sqrt(w2_sq + eps) / c).unsqueeze(-1)
+
